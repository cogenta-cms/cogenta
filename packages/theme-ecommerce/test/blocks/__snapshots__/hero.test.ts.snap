exports[`hero > renders to stable markup 1`] = `"<section class="ce-section ce-hero" data-block="hero" data-media="true"><div class="ce-container ce-hero__inner"><div class="ce-hero__heading"><p class="ce-hero__eyebrow" data-field="eyebrow">Spring batch</p><h1 class="ce-hero__title" data-field="title">Things for every day, made to last</h1></div><div class="ce-hero__aside"><p class="ce-hero__subtitle" data-field="subtitle">Clothing, bags and kitchenware from eleven small workshops.</p><ul class="cg-actions" aria-label="hero.actions"><li><a class="cg-action" data-emphasis="primary" href="/en/page/shop">Shop the collection</a></li><li><a class="cg-action" data-emphasis="secondary" href="https://example.org/workshops" rel="noopener noreferrer">Our workshops</a></li></ul></div></div><figure class="ce-hero__media"><img class="ce-hero__image" src="/img/hero-1600.avif" srcset="/img/hero-1600.avif 1600w" sizes="100vw" width="1600" height="914" alt="Canvas tote and a beanie on linen" loading="eager" decoding="async" style="object-position:50% 40%"></figure></section>"`;
