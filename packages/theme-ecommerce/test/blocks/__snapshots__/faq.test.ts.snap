// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`faq > renders to stable markup 1`] = `"<section class="ce-section ce-answers" data-block="faq" data-titled="true"><div class="ce-container ce-answers__inner"><div class="ce-head"><h2 class="ce-head__title" data-field="title">Before you order</h2></div><ul class="ce-answers__items"><li class="ce-answers__item"><details class="ce-answers__details"><summary class="ce-answers__summary"><h3 class="ce-answers__question">How long does delivery take?</h3><span class="ce-answers__mark" aria-hidden="true"></span></summary><div class="ce-answers__answer"><p>Two to three working days in Portugal.</p></div></details></li></ul></div></section>"`;
