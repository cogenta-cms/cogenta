exports[`mediaFigure > renders to stable markup 1`] = `"<div class="ce-section ce-figure" data-block="mediaFigure" data-align="start" data-layout="split"><figure class="ce-container ce-figure__inner"><div class="ce-figure__frame" style="aspect-ratio:1 / 1"><img class="ce-figure__image" src="/img/figure-1200.avif" srcset="/img/figure-1200.avif 1200w" sizes="(min-width: 64rem) 55vw, 100vw" width="1200" height="1200" alt="Enamel mug on an oak table" loading="lazy" decoding="async"></div><figcaption class="ce-figure__caption"><span class="ce-figure__text" data-field="caption">We opened in 2014 as a repair bench.</span><span class="ce-figure__credit" data-field="credit">Enamel mug, made in Olkusz</span></figcaption></figure></div>"`;
