exports[`the vocabulary blocks > renders featureGrid to stable markup 1`] = `"<section class="cg-block cg-features" data-block="featureGrid"><h2 class="cg-features__title" data-field="title">What you get</h2><ul class="cg-features__items"><li class="cg-feature"><span class="cg-feature__icon" data-icon="shield" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2 20 5.5v5.5c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5.5z"></path></svg></span><h3 class="cg-feature__title"><a class="cg-feature__link" href="/en/page/themes">Sandboxed themes</a></h3><p class="cg-feature__text">No database, no secrets.</p></li><li class="cg-feature"><h3 class="cg-feature__title">Three databases</h3><p class="cg-feature__text">Postgres, MySQL, SQLite.</p></li></ul></section>"`;

exports[`the vocabulary blocks > renders gallery to stable markup 1`] = `"<section class="cg-block cg-gallery" data-block="gallery" data-layout="carousel"><div class="cg-gallery__viewport" role="region" aria-label="gallery.carousel" tabindex="0"><ul class="cg-gallery__items"><li class="cg-gallery__item"><img src="/img/g1-400.avif" sizes="(min-width: 45rem) 20rem, 60vw" width="400" height="400" alt="Detail of a printed page" loading="lazy" decoding="async"></li><li class="cg-gallery__item"><img src="/img/g2-400.avif" sizes="(min-width: 45rem) 20rem, 60vw" width="400" height="400" alt="Detail of a bound spine" loading="lazy" decoding="async"></li></ul></div></section>"`;

exports[`the vocabulary blocks > renders hero to stable markup 1`] = `"<section class="cg-block cg-hero" data-block="hero"><div class="cg-hero__body"><p class="cg-hero__eyebrow" data-field="eyebrow">Architecture</p><h1 class="cg-hero__title" data-field="title">A CMS that runs itself</h1><p class="cg-hero__subtitle" data-field="subtitle">The agent runtime is in the core, not in a plugin.</p><ul class="cg-actions" aria-label="hero.actions"><li><a class="cg-action" data-emphasis="primary" href="/en/page/vision">Read the vision</a></li><li><a class="cg-action" data-emphasis="secondary" href="https://github.com/cogenta-cms/cogenta" rel="noopener noreferrer">Source</a></li></ul></div><div class="cg-hero__media"><img src="/img/hero-1200.avif" srcset="/img/hero-600.avif 600w, /img/hero-1200.avif 1200w" sizes="(min-width: 60rem) 50vw, 100vw" width="1200" height="630" alt="A workshop bench seen from above" loading="eager" decoding="async" style="object-position:50% 33%"></div></section>"`;

