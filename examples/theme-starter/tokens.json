{
  "color": {
    "bg": "#ffffff",
    "fg": "#16181d",
    "accent": "#1d4ed8",
    "accentFg": "#ffffff",
    "muted": "#f2f4f7",
    "mutedFg": "#3f4655",
    "border": "#d7dbe2"
  },
  "font": {
    "sans": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "serif": "ui-serif, Georgia, Cambria, 'Times New Roman', serif",
    "mono": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace",
    "scale": 1.25,
    "baseSize": "1rem"
  },
  "space": {
    "unit": "0.25rem",
    "density": "comfortable"
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "1rem"
  },
  "motion": {
    "duration": "180ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "reduced": true
  },
  "shadow": {
    "sm": "0 1px 2px rgba(22, 24, 29, 0.08)",
    "md": "0 6px 24px rgba(22, 24, 29, 0.12)"
  }
}
