node_modules/
dist/
build/
# ...except source directories that happen to be named `build`. The rule above
# targets build *output*; `@cogenta/render` has a `build/` module — the three
# delivery targets — and its sources and tests must be committed.
!packages/*/src/build/
!packages/*/test/build/
.turbo/
.cogenta/
coverage/
*.tsbuildinfo

.env
.env.*
!.env.example

*.log
npm-debug.log*
pnpm-debug.log*

.DS_Store
Thumbs.db

.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code: shared config is committed, per-developer overrides are not.
.claude/settings.local.json

# Test artefacts
playwright-report/
test-results/
.playwright/

*.sqlite
*.sqlite3
*.db
