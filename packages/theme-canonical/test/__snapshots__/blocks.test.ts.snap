exports[`the vocabulary blocks > renders collectionList to stable markup 1`] = `"<section class="cg-block cg-collection" data-block="collectionList" data-layout="list"><h2 class="cg-collection__title" data-field="title">Latest articles</h2><ul class="cg-collection__items"><li class="cg-entry"><article class="cg-entry__body"><h3 class="cg-entry__title"><a class="cg-entry__link" href="/en/article/0192f0c2-0000-7000-8000-000000000001">Two planes, one site</a></h3><time class="cg-entry__date" datetime="2026-02-11T09:00:00.000Z">February 11, 2026</time><p class="cg-entry__excerpt">Why the render process holds neither the secrets nor the database.</p></article></li><li class="cg-entry"><article class="cg-entry__body"><h3 class="cg-entry__title"><a class="cg-entry__link" href="/en/article/0192f0c2-0000-7000-8000-000000000002">entry.untitled</a></h3><time class="cg-entry__date" datetime="2026-01-05T09:00:00.000Z">January 5, 2026</time></article></li></ul></section>"`;

