// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`stats > renders to stable markup 1`] = `"<section class="cs-section cs-figures" data-block="stats" data-count="2"><div class="cs-container cs-figures__inner"><div class="cs-head"><h2 class="cs-head__title" data-field="title">Across every workspace, last quarter</h2></div><dl class="cs-figures__items"><div class="cs-figures__item"><dt class="cs-figures__label">median time to approve</dt><dd class="cs-figures__value"><span class="cs-figures__number">3.6</span><span class="cs-figures__unit">h</span></dd></div><div class="cs-figures__item"><dt class="cs-figures__label">uptime</dt><dd class="cs-figures__value"><span class="cs-figures__number">99.99</span><span class="cs-figures__unit">%</span></dd></div></dl></div></section>"`;
