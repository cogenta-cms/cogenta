{
  "name": "create-cogenta",
  "version": "0.1.2",
  "description": "The Cogenta installer wizard — npm create cogenta.",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "create-cogenta": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogenta-cms/cogenta.git",
    "directory": "packages/create-cogenta"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cogenta/agents": "workspace:*",
    "@cogenta/auth": "workspace:*",
    "@cogenta/blocks": "workspace:*",
    "@cogenta/cli": "workspace:*",
    "@cogenta/core": "workspace:*",
    "@cogenta/render": "workspace:*",
    "@cogenta/schema": "workspace:*",
    "@cogenta/theme-canonical": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
