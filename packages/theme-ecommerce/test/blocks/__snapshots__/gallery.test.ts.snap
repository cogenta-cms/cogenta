exports[`gallery > renders to stable markup 1`] = `"<div class="ce-section ce-gallery" data-block="gallery" data-layout="carousel"><div class="ce-container ce-gallery__inner"><div class="ce-gallery__viewport" role="region" aria-label="gallery.carousel" tabindex="0"><ul class="ce-gallery__items"><li class="ce-gallery__item"><img class="ce-gallery__image" src="/img/g1-800.avif" srcset="/img/g1-800.avif 800w" sizes="(min-width: 64rem) 30vw, 80vw" width="800" height="800" alt="Detail of a stitched strap" loading="lazy" decoding="async"></li><li class="ce-gallery__item"><img class="ce-gallery__image" src="/img/g2-800.avif" srcset="/img/g2-800.avif 800w" sizes="(min-width: 64rem) 30vw, 80vw" width="800" height="800" alt="Detail of a knitted cuff" loading="lazy" decoding="async"></li></ul></div></div></div>"`;
