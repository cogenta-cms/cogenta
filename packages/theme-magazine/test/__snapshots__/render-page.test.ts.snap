exports[`the seventeen vocabulary blocks > renders hero to stable markup 1`] = `"<section class="cg-section cg-cover" data-block="hero" data-media="image"><div class="cg-container cg-cover__inner"><div class="cg-cover__copy"><p class="cg-cover__kicker" data-field="eyebrow">Field report</p><h1 class="cg-cover__title" data-field="title">The last hot-metal shop in the county</h1><p class="cg-cover__standfirst" data-field="subtitle">Four machines, one operator, and a waiting list of collectors who want them running.</p><ul class="cg-actions" aria-label="hero.actions"><li><a class="cg-action" data-emphasis="primary" href="/en/article/shop">Read the story</a></li><li><a class="cg-action" data-emphasis="secondary" href="https://example.org/guild" rel="noopener noreferrer">About the guild</a></li></ul></div><div class="cg-cover__media"><img class="cg-cover__image" src="/img/hero-1200.avif" srcset="/img/hero-600.avif 600w, /img/hero-1200.avif 1200w" sizes="(min-width: 64rem) 46rem, 100vw" width="1200" height="630" alt="A linotype machine mid-cast" loading="eager" decoding="async" style="object-position:50% 33%"></div></div></section>"`;

