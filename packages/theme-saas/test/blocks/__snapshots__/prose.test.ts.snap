// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`prose > renders to stable markup 1`] = `"<div class="cs-section cs-prose" data-block="prose"><div class="cs-container cs-prose__inner"><div class="cs-prose__body"><p>Workspaces are hosted in <strong>Frankfurt</strong> or Virginia, and <a href="https://example.org/backups" rel="external">every backup is restored</a> once a month &amp; checked &lt;by hand&gt;.</p><h2>Encryption</h2><ul><li>TLS 1.3 in transit<ul><li>HSTS preloaded</li></ul></li></ul><blockquote><p>Keys are rotated every 90 days.</p></blockquote><figure class="cg-prose__figure"><img src="/img/inline-1600.png" srcset="/img/inline-1600.png 1600w" sizes="(min-width: 45rem) 40rem, 100vw" width="1600" height="1000" alt="The request form" loading="lazy" decoding="async"><figcaption>The request form</figcaption></figure></div></div></div>"`;
