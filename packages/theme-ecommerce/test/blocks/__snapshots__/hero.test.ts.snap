// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`hero > renders to stable markup 1`] = `"<section class="ce-block ce-hero" data-block="hero"><div class="ce-hero__copy"><p class="ce-hero__eyebrow" data-field="eyebrow">New season</p><h1 class="ce-hero__title" data-field="title">A storefront that runs itself</h1><p class="ce-hero__subtitle" data-field="subtitle">The catalogue, the copy and the checkout all live on one CMS.</p><ul class="cg-actions" aria-label="hero.actions"><li><a class="cg-action" data-emphasis="primary" href="/en/page/shop">Shop the collection</a></li><li><a class="cg-action" data-emphasis="secondary" href="https://github.com/cogenta-cms/cogenta" rel="noopener noreferrer">Source</a></li></ul></div><div class="ce-hero__media"><img class="ce-hero__image" src="/img/hero-1200.avif" srcset="/img/hero-600.avif 600w, /img/hero-1200.avif 1200w" sizes="(min-width: 64rem) 52vw, 100vw" width="1200" height="630" alt="A workshop bench seen from above" loading="eager" decoding="async" style="object-position:50% 33%"></div></section>"`;
