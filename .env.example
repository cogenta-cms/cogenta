# Copy to .env for local development. .env is git-ignored and must never be committed.
# Secrets come from the environment only, never from cogenta.config.ts.

# ─── Integration test services ────────────────────────────────────────────────
# Defaults match docker-compose.test.yml (`pnpm services:up`).
# A driver whose URL is unset is SKIPPED with a message, never silently passed.

COGENTA_TEST_POSTGRES_URL=postgres://cogenta:cogenta@127.0.0.1:55432/cogenta_test
COGENTA_TEST_MYSQL_URL=mysql://cogenta:cogenta@127.0.0.1:53306/cogenta_test
COGENTA_TEST_MARIADB_URL=mysql://cogenta:cogenta@127.0.0.1:53307/cogenta_test
COGENTA_TEST_REDIS_URL=redis://127.0.0.1:56379
COGENTA_TEST_S3_ENDPOINT=http://127.0.0.1:59000
COGENTA_TEST_S3_ACCESS_KEY=cogenta
COGENTA_TEST_S3_SECRET_KEY=cogenta-secret

# SQLite needs nothing: a temp file per test, WAL mode enabled.

# ─── Runtime (not used yet — L0 has no business data) ─────────────────────────
# DATABASE_URL=
# REDIS_URL=
# COGENTA_LLM_API_KEY=
