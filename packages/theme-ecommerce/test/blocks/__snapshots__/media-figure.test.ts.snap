// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`mediaFigure > renders to stable markup 1`] = `"<figure class="ce-block ce-figure" data-block="mediaFigure" data-align="wide" style="--ce-ratio:16 / 9"><div class="ce-figure__frame"><img class="ce-figure__media" src="/img/figure-800.avif" srcset="/img/figure-800.avif 800w" sizes="(min-width: 48rem) 42rem, 100vw" width="800" height="600" alt="A diagram of the two planes" loading="lazy" decoding="async"></div><figcaption class="ce-figure__caption"><span class="ce-figure__caption-text">The two planes</span><span class="ce-figure__credit" data-field="credit">Cogenta</span></figcaption></figure>"`;
