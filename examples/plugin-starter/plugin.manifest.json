{
  "name": "@example/plugin-starter",
  "version": "1.0.0",
  "engine": "^1.0.0",
  "capabilities": [
    "content.read",
    "storage.read:plugins/plugin-starter",
    "storage.write:plugins/plugin-starter"
  ],
  "provides": {
    "tools": ["plugin-starter.hello"],
    "blocks": [
      {
        "name": "callout",
        "label": "Encadré",
        "fallback": "quote",
        "fields": {
          "message": {
            "kind": "text",
            "required": true,
            "label": "Message",
            "options": {
              "max": 300
            }
          },
          "tone": {
            "kind": "select",
            "label": "Ton",
            "options": {
              "options": ["info", "warning"]
            }
          }
        },
        "fallbackFrom": {
          "text": "message"
        }
      }
    ],
    "widgets": [
      {
        "name": "keyFigure",
        "label": "Chiffre clé",
        "fields": {
          "value": {
            "kind": "text",
            "required": true,
            "label": "Chiffre"
          },
          "caption": {
            "kind": "text",
            "required": true,
            "label": "Légende"
          }
        }
      }
    ],
    "styles": "styles.css"
  },
  "main": "plugin.js",
  "runtime": "server",
  "isolated": true
}
