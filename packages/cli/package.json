{
  "name": "@cogenta/cli",
  "version": "0.4.0",
  "description": "The Cogenta command line: diagnose an install, run migrations, inspect drivers.",
  "license": "MPL-2.0",
  "type": "module",
  "bin": {
    "cogenta": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogenta-cms/cogenta.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('../admin/dist','dist/admin-assets',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@cogenta/agents": "workspace:*",
    "@cogenta/analytics": "workspace:*",
    "@cogenta/api": "workspace:*",
    "@cogenta/auth": "workspace:*",
    "@cogenta/blocks": "workspace:*",
    "@cogenta/channels": "workspace:*",
    "@cogenta/comments": "workspace:*",
    "@cogenta/commerce": "workspace:*",
    "@cogenta/core": "workspace:*",
    "@cogenta/export": "workspace:*",
    "@cogenta/forms": "workspace:*",
    "@cogenta/import": "workspace:*",
    "@cogenta/mcp": "workspace:*",
    "@cogenta/observability": "workspace:*",
    "@cogenta/plugins": "workspace:*",
    "@cogenta/render": "workspace:*",
    "@cogenta/schema": "workspace:*",
    "@cogenta/seo": "workspace:*",
    "@cogenta/theme-canonical": "workspace:*",
    "@cogenta/theme-ecommerce": "workspace:*",
    "@cogenta/theme-entreprise": "workspace:*",
    "@cogenta/theme-kit": "workspace:*",
    "@cogenta/theme-portfolio": "workspace:*",
    "graphql": "catalog:"
  },
  "devDependencies": {
    "@cogenta/admin": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
