// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`pricingTable > renders to stable markup 1`] = `"<section class="ce-block ce-pricing" data-block="pricingTable"><h2 class="ce-pricing__title" data-field="title">Choose your plan</h2><ul class="ce-pricing__tiers"><li class="ce-pricing__tier"><h3 class="ce-pricing__name">Standard</h3><p class="ce-pricing__price"><span class="ce-pricing__amount">$12</span><span class="ce-pricing__interval">/mo</span></p><ul class="ce-pricing__features"><li class="ce-pricing__feature">Free shipping over $75</li><li class="ce-pricing__feature">Standard returns</li></ul><div class="ce-pricing__action"><a class="cg-action" data-emphasis="secondary" href="/en/shop/standard">Choose Standard</a></div></li><li class="ce-pricing__tier" data-highlighted="true" aria-current="true"><h3 class="ce-pricing__name">Plus</h3><p class="ce-pricing__price"><span class="ce-pricing__amount">$24</span><span class="ce-pricing__interval">/mo</span></p><ul class="ce-pricing__features"><li class="ce-pricing__feature">Free shipping, no minimum</li><li class="ce-pricing__feature">Extended returns</li><li class="ce-pricing__feature">Early access drops</li></ul><div class="ce-pricing__action"><a class="cg-action" data-emphasis="primary" href="/en/shop/plus">Choose Plus</a></div></li></ul></section>"`;
