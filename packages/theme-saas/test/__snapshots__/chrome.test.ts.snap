exports[`the footer > renders to stable markup 1`] = `"<footer class="cs-footer"><div class="cs-footer__inner"><div class="cs-footer__about"><a class="cs-footer__name" href="/en">Ledgerline</a><p class="cs-footer__tagline" data-field="tagline">Spend approvals and audit trail for finance teams.</p><div class="cs-footer__note"><p>41 Tabernacle Street<br>London EC2A 4AA</p><p>Support on business days.</p></div><ul class="cs-footer__social"><li class="cs-footer__social-item"><a href="https://linkedin.com/company/example" rel="me noopener noreferrer" target="_blank"><svg class="cg-social__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" fill-rule="evenodd"><path d="M4.9 7A1.6 1.6 0 1 0 8.1 7A1.6 1.6 0 1 0 4.9 7Z"></path><path d="M6.2 10H6.800000000000001A1 1 0 0 1 7.800000000000001 11V19A1 1 0 0 1 6.800000000000001 20H6.2A1 1 0 0 1 5.2 19V11A1 1 0 0 1 6.2 10Z"></path><path d="M10.5 20V10h3v1.5c1-1.3 2.3-2 4-2c2.8 0 4.5 1.9 4.5 5V20h-3v-5c0-1.6-.7-2.6-2.2-2.6c-1.4 0-2.3 1-2.3 2.6V20z"></path></svg><span class="cg-visually-hidden">LinkedIn</span></a></li></ul></div><nav class="cs-footer__nav" aria-label="Footer" data-columns="3"><div class="cs-footer__group"><p class="cs-footer__heading">Product</p><ul class="cs-footer__links"><li class="cs-footer__item"><a href="/en/product">Overview</a></li><li class="cs-footer__item"><a href="/en/pricing">Pricing</a></li></ul></div><div class="cs-footer__group"><p class="cs-footer__heading">Company</p><ul class="cs-footer__links"><li class="cs-footer__item"><a href="/en/about">About</a></li></ul></div><div class="cs-footer__group"><p class="cs-footer__heading">Legal</p><ul class="cs-footer__links"><li class="cs-footer__item"><a href="/en/privacy">Privacy</a></li></ul></div></nav><div class="cs-footer__legal"><p class="cs-footer__copyright">© YEAR Ledgerline</p><div class="cs-footer__branding"><div class="cg-site-footer__branding">Cogenta credit</div></div></div></div></footer>"`;

exports[`the header > renders to stable markup 1`] = `"<header class="cs-header" data-nav="links"><div class="cs-header__inner"><a class="cs-header__brand" href="/en"><span class="cs-header__wordmark">Ledgerline</span></a><input type="checkbox" id="cs-nav-toggle" class="cs-nav-toggle-input" aria-label="Menu"><label for="cs-nav-toggle" class="cs-nav-toggle-label" aria-hidden="true"><span class="cs-nav-toggle-bar"></span><span class="cs-nav-toggle-bar"></span></label><nav class="cs-header__nav" id="cs-nav" aria-label="Primary"><ul class="cs-header__links"><li class="cs-header__item"><a href="/en/product">Product</a></li><li class="cs-header__item"><a href="/en/pricing">Pricing</a></li></ul></nav><div class="cs-header__end"><a class="cg-action cs-header__action" data-emphasis="primary" href="/en/demo">Book a demo</a><button type="button" class="cg-theme-toggle" data-cg-theme-toggle data-label-light="Switch to light theme" data-label-dark="Switch to dark theme" data-label-system="Use system theme" aria-label="Switch to light theme"><svg class="cg-theme-toggle__icon cg-theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 4V2M12 22v-2M4 12H2M22 12h-2M5.6 5.6 4.2 4.2M19.8 19.8l-1.4-1.4M5.6 18.4l-1.4 1.4M19.8 4.2l-1.4 1.4M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Z"></path></svg><svg class="cg-theme-toggle__icon cg-theme-toggle__icon--moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"></path></svg></button></div></div></header>"`;
