exports[`the seventeen vocabulary blocks > renders prose to stable markup 1`] = `"<div class="cg-section cg-prose" data-block="prose"><div class="cg-container cg-prose__inner"><div class="cg-prose__body"><p>The shop floor holds <strong>four working machines</strong> — see the <a href="https://example.org/inventory" rel="external">full inventory</a> &amp; the &lt;foundry&gt; ledger.</p><h2 id="what-survives-a-closure">What survives a closure</h2><ul><li>The matrices<ul><li>and the moulds that cast them</li></ul></li><li><a href="/en/page/guild">A binder willing to teach</a></li></ul><blockquote><p>Nobody retires from this trade; the trade outlives them.</p></blockquote><figure class="cg-prose__figure"><img src="/img/inline-800.avif" sizes="(min-width: 45rem) 40rem, 100vw" width="800" height="450" alt="A screenshot of the admin" loading="lazy" decoding="async"><figcaption>The composing stick, mid-line</figcaption></figure></div></div></div>"`;

exports[`the seventeen vocabulary blocks > renders quote to stable markup 1`] = `"<div class="cg-section cg-pullquote" data-block="quote"><figure class="cg-container cg-pullquote__inner"><blockquote class="cg-pullquote__quote"><p class="cg-pullquote__text" data-field="text">A composing room teaches patience before it teaches anything about type.</p></blockquote><figcaption class="cg-pullquote__attribution"><img class="cg-pullquote__avatar" src="/img/avatar-96.avif" width="96" height="96" alt="" loading="lazy" decoding="async"><span class="cg-pullquote__author" data-field="author">M. Alvarez</span><span class="cg-pullquote__role" data-field="role">Master printer</span></figcaption></figure></div>"`;

