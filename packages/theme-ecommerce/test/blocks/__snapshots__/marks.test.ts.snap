// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`logoStrip > renders to stable markup 1`] = `"<div class="ce-section ce-strip" data-block="logoStrip" data-captioned="true"><div class="ce-container ce-strip__inner"><p class="ce-strip__caption" data-field="caption">Also sold by</p><ul class="ce-strip__items"><li class="ce-strip__item"><span class="ce-marks__plate"><img class="ce-marks__image" src="/img/rossio.png" srcset="/img/rossio.png 320w" sizes="10rem" width="320" height="80" alt="" loading="lazy" decoding="async"></span></li><li class="ce-strip__item"><span class="ce-marks__plate"><img class="ce-marks__image" src="/img/marlowe.png" srcset="/img/marlowe.png 320w" sizes="10rem" width="320" height="80" alt="" loading="lazy" decoding="async"></span></li></ul></div></div>"`;

exports[`logos > renders to stable markup 1`] = `"<section class="ce-section ce-marks" data-block="logos"><div class="ce-container ce-marks__inner"><div class="ce-head"><h2 class="ce-head__title" data-field="title">Stocked by</h2></div><ul class="ce-marks__items"><li class="ce-marks__item"><a class="ce-marks__plate" href="https://rossio.example" aria-label="Rossio Hardware" rel="noopener noreferrer"><img class="ce-marks__image" src="/img/rossio.png" srcset="/img/rossio.png 320w" sizes="10rem" width="320" height="80" alt="Rossio Hardware" loading="lazy" decoding="async"></a></li><li class="ce-marks__item"><span class="ce-marks__plate"><img class="ce-marks__image" src="/img/marlowe.png" srcset="/img/marlowe.png 320w" sizes="10rem" width="320" height="80" alt="Marlowe &amp; Daughters" loading="lazy" decoding="async"></span></li></ul></div></section>"`;
