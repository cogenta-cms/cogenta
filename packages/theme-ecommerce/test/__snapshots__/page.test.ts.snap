exports[`renderBlock > renders each block to stable markup > prose 1`] = `"<div class="ce-block ce-prose" data-block="prose"><p>The render process holds <strong>no secrets</strong> — see <a href="https://example.org/adr-0004" rel="external">ADR-0004</a> &amp; the &lt;two planes&gt; note.</p><h2>What the theme sees</h2><ul><li>The render context<ul><li>and nothing else</li></ul></li><li><a href="/en/page/contracts">A read-only content client</a></li></ul><blockquote><p>A site that runs itself.</p></blockquote><figure class="cg-prose__figure"><img src="/img/inline-800.avif" sizes="(min-width: 45rem) 40rem, 100vw" width="800" height="450" alt="A screenshot of the admin" loading="lazy" decoding="async"><figcaption>The admin, mid-review</figcaption></figure></div>"`;

