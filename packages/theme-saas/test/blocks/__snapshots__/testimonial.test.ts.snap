// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`testimonial > renders to stable markup 1`] = `"<div class="cs-section cs-testimonial" data-block="testimonial" data-portrait="true"><figure class="cs-container cs-testimonial__inner"><blockquote class="cs-testimonial__quote"><p>Invoice approvals went from nine days to under two.</p><p>The month-end close lost a day of chasing.</p></blockquote><figcaption class="cs-testimonial__attribution"><span class="cs-testimonial__name">Adrian Tan</span><span class="cs-testimonial__role">Financial Controller, Halvorsen Freight</span></figcaption><div class="cs-testimonial__portrait cs-frame"><img class="cs-testimonial__image cs-frame__image" src="/img/portrait-1024.jpg" srcset="/img/portrait-1024.jpg 1024w" sizes="(min-width: 64rem) 18rem, 4rem" width="1024" height="1024" alt="Portrait of Adrian Tan" loading="lazy" decoding="async"></div></figure></div>"`;
