{
  "name": "@cogenta/theme-association",
  "version": "0.1.0",
  "description": "A warm, human theme for a nonprofit or association: dated event cards, an impact band, and a genuine dark mode, with zero client JavaScript.",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./theme.config": {
      "types": "./dist/theme.config.d.ts",
      "default": "./dist/theme.config.js"
    },
    "./tokens.json": "./tokens.json",
    "./styles/theme.css": "./src/styles/theme.css",
    "./styles/*.css": "./src/styles/*.css"
  },
  "files": [
    "dist",
    "src",
    "tokens.json"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogenta-cms/cogenta.git",
    "directory": "packages/theme-association"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@cogenta/blocks": "workspace:*",
    "@cogenta/render": "workspace:*",
    "@cogenta/theme-kit": "workspace:*"
  },
  "peerDependencies": {
    "astro": "catalog:"
  },
  "devDependencies": {
    "astro": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
