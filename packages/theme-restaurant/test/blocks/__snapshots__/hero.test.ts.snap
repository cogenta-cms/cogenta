exports[`hero > renders to stable markup 1`] = `"<section class="cr-section cr-hero" data-block="hero" data-media="true"><figure class="cr-hero__media"><img class="cr-hero__image" src="/img/room-1600.avif" srcset="/img/room-1600.avif 1600w" sizes="100vw" width="1600" height="914" alt="The dining room set for dinner" loading="eager" decoding="async" style="object-position:50% 60%"></figure><div class="cr-container cr-hero__inner"><div class="cr-hero__heading"><p class="cr-hero__eyebrow" data-field="eyebrow">Restaurant and wine bar, Lyon</p><h1 class="cr-hero__title" data-field="title">Maison Verte</h1></div><div class="cr-hero__aside"><p class="cr-hero__subtitle" data-field="subtitle">Seasonal cooking on the slopes of the Croix-Rousse.</p><ul class="cg-actions" aria-label="hero.actions"><li><a class="cg-action" data-emphasis="secondary" href="/en/page/reservations">Reserve a table</a></li><li><a class="cg-action" data-emphasis="primary" href="https://example.org/vouchers" rel="noopener noreferrer">Gift vouchers</a></li></ul></div></div></section>"`;
