{
  "name": "@cogenta/core",
  "version": "0.2.0",
  "description": "Configuration, typed errors, structured logging and the driver system behind Cogenta.",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogenta-cms/cogenta.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests"
  },
  "dependencies": {
    "zod": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@redis/client": "catalog:",
    "postgres": "catalog:",
    "mysql2": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@aws-sdk/lib-storage": "catalog:",
    "bullmq": "catalog:"
  },
  "peerDependencies": {
    "@redis/client": "^6.2.1",
    "postgres": "^3.4.9",
    "mysql2": "^3.23.3",
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@aws-sdk/lib-storage": "^3.1109.0",
    "bullmq": "^6.1.0"
  },
  "peerDependenciesMeta": {
    "@redis/client": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    }
  }
}
