exports[`hero > renders to stable markup 1`] = `"<section class="cs-section cs-hero" data-block="hero" data-media="true"><div class="cs-container cs-hero__inner"><p class="cs-hero__eyebrow" data-field="eyebrow">For finance and operations teams</p><h1 class="cs-hero__title" data-field="title">Spend approvals with the audit trail built in</h1><p class="cs-hero__subtitle" data-field="subtitle">Route every request to the right approver and keep a record your auditors can read.</p><div class="cs-hero__actions"><ul class="cg-actions" aria-label="hero.actions"><li><a class="cg-action" data-emphasis="primary" href="/en/demo">Book a demo</a></li><li><a class="cg-action" data-emphasis="secondary" href="/en/page/pricing">See pricing</a></li></ul></div><figure class="cs-hero__media cs-frame"><img class="cs-hero__image cs-frame__image" src="/img/approvals-2400.png" srcset="/img/approvals-2400.png 2400w" sizes="(min-width: 80rem) 76rem, 100vw" width="2400" height="1520" alt="The approvals queue, with one request open" loading="eager" decoding="async"></figure></div></section>"`;
