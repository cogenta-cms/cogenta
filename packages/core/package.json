{
  "name": "@cogenta/core",
  "version": "0.0.0",
  "description": "Configuration, typed errors, structured logging and the driver system behind Cogenta.",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogenta-cms/cogenta.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@redis/client": "catalog:"
  },
  "peerDependencies": {
    "@redis/client": "^6.2.1"
  },
  "peerDependenciesMeta": {
    "@redis/client": {
      "optional": true
    }
  }
}
