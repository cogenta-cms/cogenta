exports[`embed > renders the consent notice to stable markup 1`] = `"<div class="cs-section cs-embed" data-block="embed" data-provider="youtube" data-consent="required" data-frame="notice"><div class="cs-container cs-embed__inner"><div class="cs-embed__notice"><p class="cs-embed__label">embed.label</p><p class="cs-embed__reason">embed.consentRequired</p><a class="cs-arrow-link cs-embed__link" href="https://www.youtube.com/watch?v=abc123" rel="noopener noreferrer nofollow">embed.open</a></div></div></div>"`;
