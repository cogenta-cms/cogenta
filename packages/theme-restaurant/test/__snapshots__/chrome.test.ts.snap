exports[`the footer > renders to stable markup 1`] = `"<footer class="cr-footer"><div class="cr-footer__inner"><div class="cr-footer__about"><a class="cr-footer__name" href="/en">Maison Verte</a><p class="cr-footer__tagline" data-field="tagline">Seasonal cooking on the slopes of the Croix-Rousse.</p></div><div class="cr-footer__note"><p>8 rue Burdeau<br>69001 Lyon<br>+33 4 78 28 16 42</p><p>Dinner Tuesday to Saturday.</p></div><nav class="cr-footer__nav" aria-label="Footer"><ul class="cr-footer__links"><li class="cr-footer__item"><a href="/en/reservations">Reservations</a></li><li class="cr-footer__item"><a href="/en/legal">Legal notice</a></li></ul></nav><div class="cr-footer__follow"><ul class="cr-footer__social"><li class="cr-footer__social-item"><a href="https://instagram.com/example" rel="me noopener noreferrer" target="_blank"><svg class="cg-social__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" fill-rule="evenodd"><path d="M8 3H16A5 5 0 0 1 21 8V16A5 5 0 0 1 16 21H8A5 5 0 0 1 3 16V8A5 5 0 0 1 8 3Z M9.5 6H14.5A3.5 3.5 0 0 1 18 9.5V14.5A3.5 3.5 0 0 1 14.5 18H9.5A3.5 3.5 0 0 1 6 14.5V9.5A3.5 3.5 0 0 1 9.5 6Z"></path><path d="M7.8 12A4.2 4.2 0 1 0 16.2 12A4.2 4.2 0 1 0 7.8 12Z M9.4 12A2.6 2.6 0 1 0 14.6 12A2.6 2.6 0 1 0 9.4 12Z"></path><path d="M15.7 7A1.3 1.3 0 1 0 18.3 7A1.3 1.3 0 1 0 15.7 7Z"></path></svg><span class="cg-visually-hidden">Instagram</span></a></li></ul></div><div class="cr-footer__legal"><p class="cr-footer__copyright">© YEAR Maison Verte</p><div class="cr-footer__branding"><div class="cg-site-footer__branding">Cogenta credit</div></div></div></div></footer>"`;

exports[`the header > renders to stable markup 1`] = `"<header class="cr-header" data-nav="links" data-action="link"><div class="cr-header__inner"><a class="cr-header__brand" href="/en"><span class="cr-header__wordmark">Maison Verte</span></a><input type="checkbox" id="cr-nav-toggle" class="cr-nav-toggle-input" aria-label="Navigation"><label for="cr-nav-toggle" class="cr-nav-toggle-label" aria-hidden="true"><span class="cr-nav-toggle-bar"></span><span class="cr-nav-toggle-bar"></span></label><nav class="cr-header__nav" id="cr-nav" aria-label="Primary"><ul class="cr-header__links"><li class="cr-header__item"><a href="/en/menu">Menu</a></li><li class="cr-header__item"><a href="/en/our-story">Our story</a></li></ul><div class="cr-header__card"><p>8 rue Burdeau<br>69001 Lyon<br>+33 4 78 28 16 42</p><p>Dinner Tuesday to Saturday.</p></div></nav><a class="cr-header__action" href="/en/reservations">Reserve</a><button type="button" class="cg-theme-toggle" data-cg-theme-toggle data-label-light="Switch to light theme" data-label-dark="Switch to dark theme" data-label-system="Use system theme" aria-label="Switch to light theme"><svg class="cg-theme-toggle__icon cg-theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 4V2M12 22v-2M4 12H2M22 12h-2M5.6 5.6 4.2 4.2M19.8 19.8l-1.4-1.4M5.6 18.4l-1.4 1.4M19.8 4.2l-1.4 1.4M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Z"></path></svg><svg class="cg-theme-toggle__icon cg-theme-toggle__icon--moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"></path></svg></button></div></header>"`;
