exports[`the seventeen vocabulary blocks > renders prose to stable markup 1`] = `"<div class="cg-section cg-prose" data-block="prose" data-label="false" data-length="short"><div class="cg-container cg-prose__inner"><div class="cg-prose__body"><p>The season opens with <strong>four series</strong>, each with its <a href="https://example.org/figures" rel="external">own figure</a> &amp; a &lt;poster&gt; grid.</p><h2 id="what-the-hall-kept">What the hall kept</h2><ul><li>The name<ul><li>and the building behind it</li></ul></li><li><a href="/en/page/orchestra">The orchestra</a></li></ul><blockquote><p>A poster should look like the season before it says which concert.</p></blockquote><figure class="cg-prose__figure"><img src="/img/inline-1200.avif" sizes="(min-width: 45rem) 40rem, 100vw" width="1200" height="800" alt="A spread of the annual report" loading="lazy" decoding="async"><figcaption>The calendar spread</figcaption></figure></div></div></div>"`;

exports[`the seventeen vocabulary blocks > renders quote to stable markup 1`] = `"<div class="cg-section cg-quote" data-block="quote"><figure class="cg-container cg-quote__inner"><blockquote class="cg-quote__quote"><p class="cg-quote__text" data-field="text">The team can make a poster on a Tuesday afternoon and it looks like the season.</p></blockquote><figcaption class="cg-quote__attribution"><img class="cg-quote__avatar" src="/img/avatar-96.avif" width="96" height="96" alt="" loading="lazy" decoding="async"><span class="cg-quote__who"><span class="cg-quote__author" data-field="author">Helen Marsh</span><span class="cg-quote__role" data-field="role">Director of programming, Rookery Hall</span></span></figcaption></figure></div>"`;

