{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cogenta Helm values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s:@]+(?::[0-9]+)?(?:/[^\\s:@]+)*$"
        },
        "tag": {
          "type": "string",
          "pattern": "^$|^[\\w][\\w.-]{0,127}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Recreate", "RollingUpdate"]
        }
      },
      "required": ["type"]
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://[^/@\\s]+(?::[0-9]+)?(?:/[^\\s]*)?$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "defaultLocale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "blueprint": {
          "type": "string",
          "minLength": 1
        },
        "adminEmail": {
          "type": "string",
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "trustProxy": {
          "type": ["string", "integer"],
          "pattern": "^(off|cloudflare|[0-9]+)$",
          "minimum": 0
        }
      },
      "required": [
        "url",
        "name",
        "locales",
        "defaultLocale",
        "blueprint",
        "adminEmail",
        "trustProxy"
      ]
    },
    "existingSecret": {
      "$ref": "#/definitions/name"
    },
    "secretChecksum": {
      "type": "string"
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authSigningKey": {
          "type": "string",
          "pattern": "^$|^.{32,}$"
        },
        "previewSigningKey": {
          "type": "string",
          "pattern": "^$|^.{32,}$"
        },
        "adminPassword": {
          "type": "string",
          "pattern": "^$|^.{16,}$"
        }
      },
      "required": ["authSigningKey", "previewSigningKey", "adminPassword"]
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei)$"
        },
        "storageClass": {
          "type": "string"
        },
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadWriteMany"]
        },
        "existingClaim": {
          "$ref": "#/definitions/name"
        }
      },
      "required": ["size", "storageClass", "accessMode", "existingClaim"]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver": {
          "type": "string",
          "enum": ["local", "s3"]
        },
        "bucket": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^$|^https?://[^/@\\s]+(?::[0-9]+)?(?:/[^\\s]*)?$"
        }
      },
      "required": ["driver", "bucket", "region", "endpoint"]
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver": {
          "type": "string",
          "enum": ["auto", "memory", "file", "redis"]
        }
      },
      "required": ["driver"]
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver": {
          "type": "string",
          "enum": ["memory", "redis"]
        }
      },
      "required": ["driver"]
    },
    "resources": {
      "$ref": "#/definitions/resources"
    },
    "startupProbe": {
      "$ref": "#/definitions/probe"
    },
    "livenessProbe": {
      "$ref": "#/definitions/probe"
    },
    "readinessProbe": {
      "$ref": "#/definitions/probe"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "podAnnotations": {
      "$ref": "#/definitions/stringMap"
    },
    "podLabels": {
      "$ref": "#/definitions/stringMap"
    },
    "nodeSelector": {
      "$ref": "#/definitions/stringMap"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "priorityClassName": {
      "type": "string"
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object",
            "additionalProperties": false,
            "required": ["secretKeyRef"],
            "properties": {
              "secretKeyRef": {
                "$ref": "#/definitions/secretKeyRef"
              }
            }
          }
        },
        "oneOf": [
          {
            "required": ["value"]
          },
          {
            "required": ["valueFrom"]
          }
        ]
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["secretRef"],
        "properties": {
          "prefix": {
            "type": "string"
          },
          "secretRef": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "optional": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "mountPath"],
        "properties": {
          "name": {
            "type": "string"
          },
          "mountPath": {
            "type": "string",
            "pattern": "^/"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      },
      "required": ["port", "annotations"]
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "$ref": "#/definitions/name"
            },
            "clusterIssuer": {
              "type": "string"
            }
          },
          "required": ["enabled", "secretName", "clusterIssuer"]
        }
      },
      "required": ["enabled", "className", "host", "annotations", "tls"]
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressControllerNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "additionalIngress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": ["enabled", "ingressControllerNamespace", "additionalIngress", "egress"]
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s:]+$"
        },
        "username": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$"
        },
        "database": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$"
        },
        "password": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9._~-]{16,}$"
        },
        "existingSecret": {
          "$ref": "#/definitions/name"
        },
        "secretChecksum": {
          "type": "string"
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei)$"
            },
            "storageClass": {
              "type": "string"
            },
            "existingClaim": {
              "$ref": "#/definitions/name"
            }
          },
          "required": ["size", "storageClass", "existingClaim"]
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      },
      "required": [
        "enabled",
        "image",
        "username",
        "database",
        "existingSecret",
        "secretChecksum",
        "persistence",
        "resources"
      ]
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver": {
          "type": "string",
          "enum": ["postgres", "mysql", "sqlite"]
        },
        "existingSecret": {
          "$ref": "#/definitions/name"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9._-]+$"
        }
      },
      "required": ["driver", "existingSecret", "secretKey"]
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "pattern": "^\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+$"
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1
        },
        "successfulJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "failedJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei)$"
            },
            "storageClass": {
              "type": "string"
            },
            "existingClaim": {
              "$ref": "#/definitions/name"
            }
          },
          "required": ["size", "storageClass", "existingClaim"]
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      },
      "required": [
        "enabled",
        "schedule",
        "retentionDays",
        "successfulJobsHistoryLimit",
        "failedJobsHistoryLimit",
        "activeDeadlineSeconds",
        "persistence",
        "resources"
      ]
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"]
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxUnavailable": {
          "type": ["integer", "string"],
          "minimum": 0,
          "pattern": "^(100|[0-9]{1,2})%$"
        }
      },
      "required": ["maxUnavailable"]
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "interval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        },
        "scrapeTimeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        }
      },
      "required": ["enabled", "labels", "path", "interval", "scrapeTimeout"]
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[^\\s]+:[^\\s:]+$"
        }
      },
      "required": ["image"]
    }
  },
  "required": [
    "nameOverride",
    "fullnameOverride",
    "replicaCount",
    "image",
    "imagePullSecrets",
    "strategy",
    "site",
    "existingSecret",
    "secretChecksum",
    "secrets",
    "persistence",
    "storage",
    "cache",
    "rateLimit",
    "resources",
    "startupProbe",
    "livenessProbe",
    "readinessProbe",
    "terminationGracePeriodSeconds",
    "podAnnotations",
    "podLabels",
    "nodeSelector",
    "tolerations",
    "affinity",
    "topologySpreadConstraints",
    "priorityClassName",
    "extraEnv",
    "extraEnvFrom",
    "extraVolumes",
    "extraVolumeMounts",
    "service",
    "ingress",
    "networkPolicy",
    "postgresql",
    "externalDatabase",
    "backup",
    "autoscaling",
    "podDisruptionBudget",
    "serviceMonitor",
    "test"
  ],
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "name": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "quantity": {
      "type": ["string", "number"],
      "pattern": "^[0-9]+(\\.[0-9]+)?([EPTGMK]i?|[eE][+-]?[0-9]+|[mk])?$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/quantity"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/quantity"
          }
        }
      },
      "required": ["requests"]
    },
    "probe": {
      "type": "object",
      "properties": {
        "httpGet": {
          "type": "object"
        },
        "exec": {
          "type": "object"
        },
        "tcpSocket": {
          "type": "object"
        },
        "grpc": {
          "type": "object"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "const": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["httpGet"]
        },
        {
          "required": ["exec"]
        },
        {
          "required": ["tcpSocket"]
        },
        {
          "required": ["grpc"]
        }
      ]
    },
    "secretKeyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "type": "boolean"
        }
      }
    }
  }
}
