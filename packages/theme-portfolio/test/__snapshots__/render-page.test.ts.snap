exports[`the seventeen vocabulary blocks > renders hero to stable markup 1`] = `"<section class="cg-section cg-statement" data-block="hero" data-media="image"><div class="cg-container cg-statement__inner"><p class="cg-statement__eyebrow" data-field="eyebrow">Independent design studio</p><h1 class="cg-statement__title" data-field="title">Studio Hale designs identities, books, signs and exhibitions.</h1><div class="cg-statement__aside"><p class="cg-statement__subtitle" data-field="subtitle">A studio of sixteen people in London, working since 2011.</p><ul class="cg-actions" aria-label="hero.actions"><li><a class="cg-action" data-emphasis="primary" href="/en/contact">Start a project</a></li><li><a class="cg-action" data-emphasis="secondary" href="https://example.org/work" rel="noopener noreferrer">All work</a></li></ul></div><div class="cg-statement__media"><img class="cg-statement__image" src="/img/hero-2000.avif" srcset="/img/hero-1000.avif 1000w, /img/hero-2000.avif 2000w" sizes="(min-width: 96rem) 92rem, 100vw" width="2000" height="1333" alt="Three concert posters side by side" loading="eager" decoding="async" style="object-position:50% 50%"></div></div></section>"`;

