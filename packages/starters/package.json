{
  "name": "@cogenta/starters",
  "version": "0.1.0",
  "description": "The starter content packs Cogenta seeds a new site with: collections, taxonomies, demo entries, menus, site settings and demo media per site type.",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./blueprints/*": {
      "types": "./dist/blueprints/*.d.ts",
      "default": "./dist/blueprints/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogenta-cms/cogenta.git",
    "directory": "packages/starters"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/blueprints/assets','dist/blueprints/assets',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@cogenta/api": "workspace:*",
    "@cogenta/blocks": "workspace:*",
    "@cogenta/core": "workspace:*",
    "@cogenta/render": "workspace:*",
    "@cogenta/schema": "workspace:*",
    "@cogenta/widgets": "workspace:*"
  },
  "devDependencies": {
    "@cogenta/theme-canonical": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
