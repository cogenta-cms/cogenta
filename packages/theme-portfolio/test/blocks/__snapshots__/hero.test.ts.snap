// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderHero > matches a stable snapshot 1`] = `"<section class="cg-block cg-hero" data-block="hero"><div class="cg-hero__frame"><p class="cg-hero__eyebrow" data-field="eyebrow">Selected work</p><h1 class="cg-hero__title" data-field="title">A studio that ships in the open</h1><p class="cg-hero__subtitle" data-field="subtitle">Design, motion and code, made by people who show their working.</p><ul class="cg-actions" aria-label="hero.actions"><li><a class="cg-action" data-emphasis="primary" href="/en/page/work">View the work</a></li><li><a class="cg-action" data-emphasis="secondary" href="https://github.com/cogenta-cms/cogenta" rel="noopener noreferrer">Source</a></li></ul></div><div class="cg-hero__media"><img class="cg-hero__image" src="/img/hero-1200.avif" srcset="/img/hero-600.avif 600w, /img/hero-1200.avif 1200w" sizes="(min-width: 64rem) 46vw, 100vw" width="1200" height="630" alt="A workshop bench seen from above" loading="eager" decoding="async" style="object-position:50% 33%"></div></section>"`;
