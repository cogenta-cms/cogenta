// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`collectionList, as a menu > renders to stable markup 1`] = `"<section class="cr-section cr-list" data-block="collectionList" data-layout="grid" data-shape="menu"><div class="cr-container cr-list__inner"><div class="cr-head"><h2 class="cr-head__title" data-field="title">This week’s menu</h2></div><div class="cr-list__items cr-menu" data-sections="2"><div class="cr-menu__section"><h3 class="cr-menu__section-title">Starters</h3><ul class="cr-menu__items"><li class="cr-menu__item" data-vegetarian="true"><p class="cr-menu__line"><a class="cr-menu__name" href="/en/menu_item/d-beetroot">Beetroot, goat’s curd and walnuts</a><span class="cr-menu__leader" aria-hidden="true"></span><data class="cr-menu__price" value="12">€12</data></p><p class="cr-menu__description"><span class="cr-menu__text">Crapaudine beetroot baked in salt, with fresh goat’s curd.</span><span class="cr-menu__diet">Vegetarian</span></p></li><li class="cr-menu__item"><p class="cr-menu__line"><a class="cr-menu__name" href="/en/menu_item/d-octopus">Grilled octopus, saffron and orange</a><span class="cr-menu__leader" aria-hidden="true"></span><data class="cr-menu__price" value="17.5">€17.50</data></p><p class="cr-menu__description"><span class="cr-menu__text">Braised for two hours, then grilled over vine cuttings.</span></p></li></ul></div><div class="cr-menu__section"><h3 class="cr-menu__section-title">Mains</h3><ul class="cr-menu__items"><li class="cr-menu__item"><p class="cr-menu__line"><a class="cr-menu__name" href="/en/menu_item/d-duck">Duck leg, red cabbage and juniper</a><span class="cr-menu__leader" aria-hidden="true"></span><data class="cr-menu__price" value="26">€26</data></p><p class="cr-menu__description"><span class="cr-menu__text">Cooked slowly in its own fat and crisped to order.</span></p></li><li class="cr-menu__item"><p class="cr-menu__line"><a class="cr-menu__name" href="/en/menu_item/d-morgon">Morgon Côte du Py, 2022</a><span class="cr-menu__leader" aria-hidden="true"></span><data class="cr-menu__price" value="10">€10</data></p></li></ul></div></div></div></section>"`;
