// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`collectionList, as a product tour > renders to stable markup 1`] = `"<section class="cs-section cs-list" data-block="collectionList" data-layout="list" data-shape="tour"><div class="cs-container cs-list__inner"><div class="cs-head"><h2 class="cs-head__title" data-field="title">A closer look</h2></div><ol class="cs-tour"><li class="cs-tour__item" data-side="start"><a class="cs-tour__media cs-frame" href="/en/feature/f-routing" tabindex="-1" aria-hidden="true"><img class="cs-frame__image" src="/img/policy-1600.png" srcset="/img/policy-1600.png 1600w" sizes="(min-width: 64rem) 44rem, 100vw" width="1600" height="1000" alt="The approval policy editor" loading="lazy" decoding="async"></a><div class="cs-tour__words"><h3 class="cs-tour__title"><a class="cs-tour__link" href="/en/feature/f-routing">Approval routing</a></h3><p class="cs-tour__text">Route each request by amount, cost centre and vendor.</p><a class="cs-arrow-link" href="/en/feature/f-routing">Read more<span class="cg-visually-hidden"> about Approval routing</span></a></div></li><li class="cs-tour__item" data-side="end"><a class="cs-tour__media cs-frame" href="/en/feature/f-audit" tabindex="-1" aria-hidden="true"><img class="cs-frame__image" src="/img/audit-1600.png" srcset="/img/audit-1600.png 1600w" sizes="(min-width: 64rem) 44rem, 100vw" width="1600" height="1000" alt="The audit log filtered to one request" loading="lazy" decoding="async"></a><div class="cs-tour__words"><h3 class="cs-tour__title"><a class="cs-tour__link" href="/en/feature/f-audit">Audit log</a></h3><p class="cs-tour__text">Every decision written once and never rewritten.</p><a class="cs-arrow-link" href="/en/feature/f-audit">Read more<span class="cg-visually-hidden"> about Audit log</span></a></div></li></ol></div></section>"`;
