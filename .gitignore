node_modules/
dist/
build/
# ...except source directories that happen to be named `build`. The rule above
# targets build *output*; `@cogenta/render` has a `build/` module — the three
# delivery targets — and its sources and tests must be committed.
!packages/*/src/build/
!packages/*/test/build/
# `docs-site/build/` is the static-site generator's source, not output — its
# own output is `docs-site/dist/`, already caught by the `dist/` rule above.
!docs-site/build/
.turbo/
.cogenta/
packages/cli/test/tmp/
coverage/
*.tsbuildinfo

.env
.env.*
!.env.example

*.log
npm-debug.log*
pnpm-debug.log*

.DS_Store
Thumbs.db

.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code: shared config is committed, per-developer overrides are not.
.claude/settings.local.json

# Test artefacts
playwright-report/
test-results/
.playwright/

*.sqlite
*.sqlite3
*.db

# A throwaway local test site scaffolded against the workspace's own code
# (not a published example) — never meant to be committed.
/examples/local-playground/

# QA evidence (2026-10-03 audit and its remediation): screenshots, logs and raw
# captures run to hundreds of megabytes and stay on the machine that made them.
# The written reports, and the one proof BLOCKERS.md cites, are versioned.
docs/qa/audit-2026-10-03/*
!docs/qa/audit-2026-10-03/README.md
!docs/qa/audit-2026-10-03/corrections.md
!docs/qa/audit-2026-10-03/exhaustif/
docs/qa/audit-2026-10-03/exhaustif/*
!docs/qa/audit-2026-10-03/exhaustif/evidence/
docs/qa/audit-2026-10-03/exhaustif/evidence/*
!docs/qa/audit-2026-10-03/exhaustif/evidence/provider-health-real.json
docs/qa/remediation-2026-10-03/regression/
docs/qa/remediation-2026-10-03/__pycache__/
docs/qa/remediation-2026-10-03/report-validation.json
docs/qa/remediation-2026-10-03/rapport-etape.html
docs/qa/remediation-2026-10-03/rapport-etape-mobile.png
