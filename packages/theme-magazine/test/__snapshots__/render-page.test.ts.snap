exports[`the twelve vocabulary blocks > renders faq to stable markup 1`] = `"<section class="cg-block cg-mailbag" data-block="faq"><h2 class="cg-mailbag__title" data-field="title">Reader's mailbag</h2><ul class="cg-mailbag__items"><li class="cg-mailbag__item"><details class="cg-mailbag__details"><summary class="cg-mailbag__question"><span class="cg-mailbag__number" aria-hidden="true">01</span><span class="cg-mailbag__question-text">Can I visit the shop floor?</span></summary><div class="cg-mailbag__answer"><p>Yes — by appointment, most Saturdays.</p></div></details></li></ul></section>"`;

exports[`the twelve vocabulary blocks > renders featureGrid to stable markup 1`] = `"<section class="cg-block cg-index" data-block="featureGrid"><h2 class="cg-index__heading" data-field="title">In this issue</h2><ol class="cg-index__items"><li class="cg-index__item" data-icon="press"><h3 class="cg-index__title"><a class="cg-index__link" href="/en/article/last-cast">The last cast</a></h3><p class="cg-index__text">A machine outlives its parts supplier.</p></li><li class="cg-index__item"><h3 class="cg-index__title">Reading a forme</h3><p class="cg-index__text">How to read type upside down and backwards.</p></li></ol></section>"`;

exports[`the twelve vocabulary blocks > renders gallery to stable markup 1`] = `"<section class="cg-block cg-contactsheet" data-block="gallery" data-layout="carousel"><div class="cg-contactsheet__viewport" role="region" aria-label="gallery.carousel" tabindex="0"><ul class="cg-contactsheet__items"><li class="cg-contactsheet__item"><img src="/img/g1-400.avif" sizes="(min-width: 45rem) 18rem, 50vw" width="400" height="400" alt="Detail of a printed page" loading="lazy" decoding="async"></li><li class="cg-contactsheet__item"><img src="/img/g2-400.avif" sizes="(min-width: 45rem) 18rem, 50vw" width="400" height="400" alt="Detail of a bound spine" loading="lazy" decoding="async"></li></ul></div></section>"`;

exports[`the twelve vocabulary blocks > renders hero to stable markup 1`] = `"<section class="cg-block cg-hero" data-block="hero"><div class="cg-hero__grid"><div class="cg-hero__copy"><p class="cg-hero__eyebrow" data-field="eyebrow">Field report</p><h1 class="cg-hero__title" data-field="title">The last hot-metal shop in the county</h1><p class="cg-hero__subtitle" data-field="subtitle">Four machines, one operator, and a waiting list of collectors who want them running.</p><ul class="cg-actions" aria-label="hero.actions"><li><a class="cg-action" data-emphasis="primary" href="/en/article/shop">Read the story</a></li><li><a class="cg-action" data-emphasis="secondary" href="https://example.org/guild" rel="noopener noreferrer">About the guild</a></li></ul></div><div class="cg-hero__media"><img class="cg-hero__image" src="/img/hero-1200.avif" srcset="/img/hero-600.avif 600w, /img/hero-1200.avif 1200w" sizes="(min-width: 64rem) 56vw, 100vw" width="1200" height="630" alt="A linotype machine mid-cast" loading="eager" decoding="async" style="object-position:50% 33%"></div></div></section>"`;

exports[`the twelve vocabulary blocks > renders logos to stable markup 1`] = `"<section class="cg-block cg-press" data-block="logos"><h2 class="cg-press__title" data-field="title">As seen in</h2><ul class="cg-press__items"><li class="cg-press__item"><a class="cg-press__link" href="https://acme.example" rel="noopener noreferrer"><img class="cg-press__image" src="/img/acme.svg" width="160" height="40" alt="Acme Trade Weekly" loading="lazy" decoding="async"></a></li><li class="cg-press__item"><img class="cg-press__image" src="/img/globex.svg" width="160" height="40" alt="Globex Review" loading="lazy" decoding="async"></li></ul></section>"`;

exports[`the twelve vocabulary blocks > renders mediaFigure to stable markup 1`] = `"<figure class="cg-block cg-plate" data-block="mediaFigure" data-align="wide" style="--cg-ratio:16 / 9"><img class="cg-plate__media" src="/img/figure-800.avif" srcset="/img/figure-800.avif 800w" sizes="(min-width: 60rem) 48rem, 100vw" width="800" height="600" alt="Proof sheets drying on a line" loading="lazy" decoding="async"><figcaption class="cg-plate__caption"><span class="cg-plate__text">The forme, locked and ready</span><span class="cg-plate__credit" data-field="credit">J. Okafor</span></figcaption></figure>"`;

exports[`the twelve vocabulary blocks > renders prose to stable markup 1`] = `"<div class="cg-block cg-prose" data-block="prose"><p>The shop floor holds <strong>four working machines</strong> — see the <a href="https://example.org/inventory" rel="external">full inventory</a> &amp; the &lt;foundry&gt; ledger.</p><h2>What survives a closure</h2><ul><li>The matrices<ul><li>and the moulds that cast them</li></ul></li><li><a href="/en/page/guild">A binder willing to teach</a></li></ul><blockquote><p>Nobody retires from this trade; the trade outlives them.</p></blockquote><figure class="cg-prose__figure"><img src="/img/inline-800.avif" sizes="(min-width: 45rem) 40rem, 100vw" width="800" height="450" alt="A screenshot of the admin" loading="lazy" decoding="async"><figcaption>The composing stick, mid-line</figcaption></figure></div>"`;

exports[`the twelve vocabulary blocks > renders quote to stable markup 1`] = `"<figure class="cg-block cg-pullquote" data-block="quote"><blockquote class="cg-pullquote__text"><p data-field="text">A composing room teaches patience before it teaches anything about type.</p></blockquote><figcaption class="cg-pullquote__attribution"><img class="cg-pullquote__avatar" src="/img/avatar-96.avif" width="96" height="96" alt="" loading="lazy" decoding="async"><span class="cg-pullquote__names"><span class="cg-pullquote__author" data-field="author">M. Alvarez</span><span class="cg-pullquote__role" data-field="role">Master printer</span></span></figcaption></figure>"`;

exports[`the twelve vocabulary blocks > renders stats to stable markup 1`] = `"<section class="cg-block cg-figures" data-block="stats"><h2 class="cg-figures__title" data-field="title">By the numbers</h2><dl class="cg-figures__items"><div class="cg-figures__item"><dt class="cg-figures__label">Working machines</dt><dd class="cg-figures__value">4</dd></div><div class="cg-figures__item"><dt class="cg-figures__label">Oldest still casting</dt><dd class="cg-figures__value">112<span class="cg-figures__unit">yrs</span></dd></div></dl></section>"`;
