exports[`quote > renders to stable markup 1`] = `"<div class="ce-section ce-quote" data-block="quote"><figure class="ce-container ce-quote__inner"><blockquote class="ce-quote__quote"><p class="ce-quote__text" data-field="text">We only sell what our workshops make to be mended.</p></blockquote><figcaption class="ce-quote__attribution"><img class="ce-quote__avatar" src="/img/avatar-96.avif" srcset="/img/avatar-96.avif 96w" sizes="3rem" width="96" height="96" alt="" loading="lazy" decoding="async"><span class="ce-quote__who"><span class="ce-quote__author" data-field="author">Marta Leal</span><span class="ce-quote__role" data-field="role">Founder</span></span></figcaption></figure></div>"`;
