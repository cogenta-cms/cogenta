{
  "color": {
    "bg": "#FBF3E4",
    "fg": "#22281F",
    "accent": "#1F6B47",
    "accentFg": "#FFFFFF",
    "muted": "#F1E4C9",
    "mutedFg": "#5B4E36",
    "border": "#E3D2AC"
  },
  "font": {
    "sans": "'Source Sans 3', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "serif": "'Nunito', ui-rounded, 'Segoe UI', system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace",
    "scale": 1.25,
    "baseSize": "1rem"
  },
  "space": {
    "unit": "0.25rem",
    "density": "comfortable"
