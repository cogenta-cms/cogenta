exports[`renderFeatureGrid > matches a stable snapshot 1`] = `"<section class="cg-block cg-features" data-block="featureGrid"><h2 class="cg-features__title" data-field="title">What we do</h2><ul class="cg-features__items"><li class="cg-feature" data-icon="shield"><svg class="cg-feature__icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2 20 5.5v5.5c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5.5z"></path></svg><span class="cg-feature__index" aria-hidden="true"></span><h3 class="cg-feature__title"><a class="cg-feature__link" href="/en/page/services">Brand systems</a></h3><p class="cg-feature__text">Identity, type and motion, documented.</p></li><li class="cg-feature"><span class="cg-feature__index" aria-hidden="true"></span><h3 class="cg-feature__title">Product design</h3><p class="cg-feature__text">From brief to shipped interface.</p></li></ul></section>"`;
