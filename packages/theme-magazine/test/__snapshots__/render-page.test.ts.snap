exports[`the twelve vocabulary blocks > renders collectionList to stable markup 1`] = `"<section class="cg-block cg-issue" data-block="collectionList" data-layout="list"><h2 class="cg-issue__title" data-field="title">Latest dispatches</h2><div class="cg-issue__spread"><article class="cg-issue__lead"><p class="cg-issue__kicker">collection.featured</p><h3 class="cg-issue__lead-title"><a class="cg-issue__link" href="/en/article/0192f0c2-0000-7000-8000-000000000001">The last hot-metal shop in the county</a></h3><p class="cg-issue__lead-excerpt">What it takes to keep a Linotype running when no one makes the parts any more.</p><time class="cg-issue__lead-date" datetime="2026-02-11T09:00:00.000Z">February 11, 2026</time></article><ol class="cg-issue__rest"><li class="cg-issue__row"><span class="cg-issue__row-number" aria-hidden="true">02</span><div class="cg-issue__row-body"><h3 class="cg-issue__row-title"><a class="cg-issue__link" href="/en/article/0192f0c2-0000-7000-8000-000000000002">entry.untitled</a></h3><time class="cg-issue__row-date" datetime="2026-01-28T09:00:00.000Z">Jan 28, 2026</time></div></li><li class="cg-issue__row"><span class="cg-issue__row-number" aria-hidden="true">03</span><div class="cg-issue__row-body"><h3 class="cg-issue__row-title"><a class="cg-issue__link" href="/en/article/0192f0c2-0000-7000-8000-000000000003">Notes from the letterpress guild</a></h3><time class="cg-issue__row-date" datetime="2026-01-05T09:00:00.000Z">Jan 5, 2026</time></div></li></ol></div></section>"`;

exports[`the twelve vocabulary blocks > renders cta to stable markup 1`] = `"<section class="cg-block cg-subscribe" data-block="cta"><h2 class="cg-subscribe__title" data-field="title">Subscribe to the print edition</h2><p class="cg-subscribe__text" data-field="text">Four issues a year, mailed flat, no digital edition.</p><ul class="cg-actions" aria-label="Subscribe to the print edition"><li><a class="cg-action" data-emphasis="primary" href="/en/subscribe">Subscribe</a></li></ul></section>"`;

