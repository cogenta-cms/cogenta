// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`statCounter > renders to stable markup 1`] = `"<section class="ce-section ce-figures" data-block="statCounter" data-count="2"><div class="ce-container ce-figures__inner"><div class="ce-head"><h2 class="ce-head__title" data-field="title">Last year at the bench</h2></div><dl class="ce-figures__items"><div class="ce-figures__item"><dt class="ce-figures__label">repairs completed</dt><dd class="ce-figures__value">1,380</dd></div><div class="ce-figures__item"><dt class="ce-figures__label">days on average</dt><dd class="ce-figures__value">16</dd></div></dl></div></section>"`;

exports[`stats > renders to stable markup 1`] = `"<section class="ce-section ce-figures" data-block="stats" data-count="2"><div class="ce-container ce-figures__inner"><div class="ce-head"><h2 class="ce-head__title" data-field="title">The shop in numbers</h2></div><dl class="ce-figures__items"><div class="ce-figures__item"><dt class="ce-figures__label">repairs last year</dt><dd class="ce-figures__value">1,380</dd></div><div class="ce-figures__item"><dt class="ce-figures__label">done free of charge</dt><dd class="ce-figures__value">62<span class="ce-figures__unit">%</span></dd></div></dl></div></section>"`;
