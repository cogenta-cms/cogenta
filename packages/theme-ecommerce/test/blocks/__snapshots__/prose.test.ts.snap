// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`prose > renders to stable markup 1`] = `"<div class="ce-section ce-prose" data-block="prose"><div class="ce-container ce-prose__inner"><div class="ce-prose__body"><p>Every piece is <strong>mended at the shop</strong>, see <a href="https://example.org/repairs" rel="external">repairs</a> &amp; the &lt;bench&gt; note.</p><h2 id="what-we-mend">What we mend</h2><ul><li>Seams and buttons<ul><li>on anything we sold</li></ul></li><li><a href="/en/page/repairs">Straps and hooks</a></li></ul><blockquote><p>Made to be mended.</p></blockquote><figure class="cg-prose__figure"><img src="/img/inline-800.avif" srcset="/img/inline-800.avif 800w" sizes="(min-width: 45rem) 40rem, 100vw" width="800" height="533" alt="The repair bench" loading="lazy" decoding="async"><figcaption>The bench, mid-repair</figcaption></figure></div></div></div>"`;
