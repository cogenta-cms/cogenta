// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`featureGrid, as features > renders to stable markup 1`] = `"<section class="cs-section cs-features" data-block="featureGrid" data-shape="features" data-count="3"><div class="cs-container cs-features__inner"><div class="cs-head"><h2 class="cs-head__title" data-field="title">One place for every approval</h2></div><ul class="cs-features__items"><li class="cs-features__item" data-icon="true"><div class="cs-features__heading"><svg class="cs-features__icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3 3 8l9 5 9-5z"></path><path d="M3 13l9 5 9-5"></path><path d="M3 18l9 5 9-5"></path></svg><h3 class="cs-features__title">Approval routing</h3></div><p class="cs-features__text">By amount and cost centre.</p></li><li class="cs-features__item" data-icon="true"><div class="cs-features__heading"><svg class="cs-features__icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2 20 5.5v5.5c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5.5z"></path></svg><h3 class="cs-features__title"><a class="cs-features__link" href="/en/feature/f-audit">Audit log</a></h3></div><p class="cs-features__text">Written once, never rewritten.</p></li><li class="cs-features__item" data-icon="false"><div class="cs-features__heading"><h3 class="cs-features__title">API and webhooks</h3></div></li></ul></div></section>"`;
