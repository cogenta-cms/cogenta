exports[`the product page > renders to stable markup 1`] = `"<main class="cg-main ce-main ce-main--product" id="cg-main"><article class="ce-product" data-stock="in" data-media="true"><div class="ce-container ce-product__inner"><figure class="ce-product__media"><img class="ce-product__image" src="/img/jacket-1024.avif" srcset="/img/jacket-1024.avif 1024w" sizes="(min-width: 64rem) 56vw, 100vw" width="1024" height="1024" alt="Olive field jacket" loading="eager" decoding="async"></figure><div class="ce-product__info"><p class="ce-product__category">Wear</p><h1 class="ce-product__title">Field jacket</h1><p class="ce-product__price"><span class="cg-visually-hidden">Price </span><data value="245">€245</data></p><p class="ce-product__stock" data-stock="in">In stock</p><p class="ce-product__summary">A four-pocket jacket in olive cotton drill.</p><p class="ce-product__order"><a class="cg-action" data-emphasis="primary" href="mailto:orders@ateliergoods.com?subject=Order%3A%20Field%20jacket">Order by email</a></p><p class="ce-product__delivery"><span class="ce-product__delivery-label">Delivery</span> Ships from Lisbon within two working days.</p><div class="ce-product__details"><h2 class="ce-product__details-title">Details</h2><dl class="ce-product__facts"><div class="ce-product__fact" data-fact="material"><dt class="ce-product__fact-label">Material</dt><dd class="ce-product__fact-value">Cotton drill, 280 g/m².</dd></div><div class="ce-product__fact" data-fact="dimensions"><dt class="ce-product__fact-label">Dimensions</dt><dd class="ce-product__fact-value">Sizes XS to XL.</dd></div><div class="ce-product__fact" data-fact="origin"><dt class="ce-product__fact-label">Made in</dt><dd class="ce-product__fact-value">Guimarães, Portugal</dd></div><div class="ce-product__fact" data-fact="care"><dt class="ce-product__fact-label">Care</dt><dd class="ce-product__fact-value">Wash at 30 °C.</dd></div></dl></div></div></div></article></main>"`;
