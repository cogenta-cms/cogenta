{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // Test fixtures are excluded on purpose: some of them are *hostile by
    // design* — CommonJS, forbidden imports, unresolvable specifiers — because
    // that is what the theme installation check exists to refuse. Linting them
    // would report the very things the tests assert are present.
    "includes": [
      "**",
      "!**/dist",
      "!**/.turbo",
      "!**/coverage",
      "!**/test/fixtures",
      // Sources of bundled demo images (L36, one folder per blueprint): throwaway pages rendered once in a
      // browser to make PNGs, never served, so accessibility rules do not apply.
      "!**/starters/scripts/*-assets",
      // Immutable historical audit evidence and one-off scripts are archived
      // together; maintained regression suites live in tests/e2e.
      "!docs/qa/audit-2026-10-03",
      "!docs/qa/pentest-2026-10-26",
      // Generated by `scripts/fetch-theme-fonts.mjs` (the `@font-face` rules of
      // each theme's self-hosted fonts); `fonts/manifest.json` carries the same
      // rules verbatim, so reformatting this file would make the two disagree.
      "!packages/*/src/styles/fonts.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "css": {
    // `packages/admin/src/styles/theme.css` declares the admin's design tokens
    // with Tailwind v4's `@theme` (L11 task 1). Without this, Biome's CSS
    // parser rejects the file outright ("Tailwind-specific syntax is
    // disabled") and cannot lint or format it at all.
    "parser": { "tailwindDirectives": true }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": { "level": "error", "options": { "allow": [] } }
      },
      "style": {
        "useNodejsImportProtocol": "error",
        "noDefaultExport": "error",
        "useConsistentArrayType": { "level": "error", "options": { "syntax": "shorthand" } },
        "noNonNullAssertion": "error"
      },
      "complexity": {
        "noForEach": "off"
      },
      "correctness": {
        "noUndeclaredDependencies": "error",
        // Off on purpose: the project is ESM + NodeNext, where a relative import
        // must carry the *emitted* `.js` extension. This rule asks for `.ts`,
        // which tsc rejects. tsc already enforces the extension itself.
        "useImportExtensions": "off"
      }
    }
  },
  "overrides": [
    {
      // Biome parses Astro frontmatter but not the template, so it reports every
      // prop the template uses as an unused variable. Silencing the rule beats
      // teaching contributors to ignore 60 warnings.
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": { "noUnusedVariables": "off", "noUnusedImports": "off" }
        }
      }
    },
    {
      "includes": ["**/*.config.ts", "**/*.config.js", "**/vitest.workspace.ts"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      // `cogenta schema.ts` files are loaded by `@cogenta/cli`'s `loadCollections`
      // via `module.default` (see `packages/cli/src/commands/serve.ts`) — the
      // default export is the contract, not a style choice.
      "includes": ["**/cogenta.schema.ts"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      // A plugin manifest is loaded by `@cogenta/plugins`'s `loadPlugin` via
      // `module.default` (`packages/plugins/src/loader.ts`), same reasoning
      // as `cogenta.schema.ts` above — the default export is the contract.
      "includes": [
        "**/plugin.manifest.ts",
        "**/plugin.manifest.mts",
        "**/plugin.manifest.js",
        "**/plugin.manifest.mjs"
      ],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      "includes": ["**/test/**", "**/*.test.ts", "**/*.spec.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" },
          "correctness": { "noUndeclaredDependencies": "off" }
        }
      }
    },
    {
      "includes": [".claude/hooks/*.mjs"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    }
  ]
}
