exports[`the vocabulary blocks > renders pricingTable to stable markup 1`] = `"<section class="cg-block cg-pricing" data-block="pricingTable"><h2 class="cg-pricing__title" data-field="title">Plans</h2><ul class="cg-pricing__tiers"><li class="cg-pricing__tier"><h3 class="cg-pricing__name">Starter</h3><p class="cg-pricing__price"><span class="cg-pricing__amount">$0</span><span class="cg-pricing__interval">/mo</span></p><ul class="cg-pricing__features"><li>One site</li><li>Community support</li></ul></li><li class="cg-pricing__tier" data-highlighted="true" aria-current="true"><h3 class="cg-pricing__name">Pro</h3><p class="cg-pricing__price"><span class="cg-pricing__amount">$29</span><span class="cg-pricing__interval">/mo</span></p><ul class="cg-pricing__features"><li>Unlimited sites</li><li>Priority support</li></ul><div class="cg-pricing__action"><a class="cg-action" data-emphasis="primary" href="/en/pricing/pro">Choose Pro</a></div></li></ul></section>"`;

exports[`the vocabulary blocks > renders prose to stable markup 1`] = `"<div class="cg-block cg-prose" data-block="prose"><p>The render process holds <strong>no secrets</strong> — see <a href="https://example.org/adr-0004" rel="external">ADR-0004</a> &amp; the &lt;two planes&gt; note.</p><h2>What the theme sees</h2><ul><li>The render context<ul><li>and nothing else</li></ul></li><li><a href="/en/page/contracts">A read-only content client</a></li></ul><blockquote><p>A site that runs itself.</p></blockquote><figure class="cg-prose__figure"><img src="/img/inline-800.avif" sizes="(min-width: 45rem) 40rem, 100vw" width="800" height="450" alt="A screenshot of the admin" loading="lazy" decoding="async"><figcaption>The admin, mid-review</figcaption></figure><hr class="cg-prose__rule"><p><s>No longer accurate.</s></p></div>"`;

