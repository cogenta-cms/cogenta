// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`pricingTable, as a comparison > renders to stable markup 1`] = `"<section class="cs-section cs-pricing" data-block="pricingTable" data-shape="compare" data-count="3" data-titled="true"><div class="cs-container cs-pricing__inner"><div class="cs-pricing__top"><div class="cs-pricing__lead"><div class="cs-head"><h2 class="cs-head__title" data-field="title">Plans</h2></div></div><ul class="cs-pricing__plans" aria-label="Plans"><li class="cs-plan" data-highlighted="false"><span class="cs-plan__flag" aria-hidden="true"></span><h3 class="cs-plan__name">Team</h3><p class="cs-plan__price"><span class="cs-plan__amount">$12</span><span class="cs-plan__interval">per approver, per month</span></p><div class="cs-plan__action"><a class="cg-action" data-emphasis="secondary" href="/en/demo">Start a trial</a></div></li><li class="cs-plan" data-highlighted="true"><span class="cs-plan__flag">Recommended</span><h3 class="cs-plan__name">Business</h3><p class="cs-plan__price"><span class="cs-plan__amount">$24</span><span class="cs-plan__interval">per approver, per month</span></p><div class="cs-plan__action"><a class="cg-action" data-emphasis="primary" href="/en/demo">Start a trial</a></div></li><li class="cs-plan" data-highlighted="false"><span class="cs-plan__flag" aria-hidden="true"></span><h3 class="cs-plan__name">Enterprise</h3><p class="cs-plan__price"><span class="cs-plan__amount">Custom</span><span class="cs-plan__interval">annual contract</span></p><div class="cs-plan__action"><a class="cg-action" data-emphasis="secondary" href="/en/demo">Talk to sales</a></div></li></ul></div><div class="cs-compare" role="region" aria-label="Plans" tabindex="0"><table class="cs-compare__table"><caption class="cg-visually-hidden">Plans</caption><colgroup><col class="cs-compare__col" data-column="label"><col class="cs-compare__col" data-column="plan"><col class="cs-compare__col" data-column="plan"><col class="cs-compare__col" data-column="plan"></colgroup><thead><tr><th scope="col" class="cs-compare__corner">Feature</th><th scope="col" class="cs-compare__tier" data-highlighted="false">Team</th><th scope="col" class="cs-compare__tier" data-highlighted="true">Business</th><th scope="col" class="cs-compare__tier" data-highlighted="false">Enterprise</th></tr></thead><tbody><tr class="cs-compare__row"><th scope="row" class="cs-compare__label">Approvers</th><td class="cs-compare__cell" data-value="text">Up to 25</td><td class="cs-compare__cell" data-value="text">Up to 250</td><td class="cs-compare__cell" data-value="text">Unlimited</td></tr><tr class="cs-compare__row"><th scope="row" class="cs-compare__label">Audit history</th><td class="cs-compare__cell" data-value="text">1 year</td><td class="cs-compare__cell" data-value="text">7 years</td><td class="cs-compare__cell" data-value="text">10 years</td></tr><tr class="cs-compare__row"><th scope="row" class="cs-compare__label">Signed audit exports</th><td class="cs-compare__cell" data-value="none"><span class="cs-compare__none" aria-hidden="true"></span><span class="cg-visually-hidden">Not included</span></td><td class="cs-compare__cell" data-value="included"><span class="cs-compare__check" aria-hidden="true"></span><span class="cg-visually-hidden">Included</span></td><td class="cs-compare__cell" data-value="included"><span class="cs-compare__check" aria-hidden="true"></span><span class="cg-visually-hidden">Included</span></td></tr></tbody></table></div></div></section>"`;
