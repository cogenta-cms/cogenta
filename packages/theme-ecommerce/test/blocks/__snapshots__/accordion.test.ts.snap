exports[`accordion > renders to stable markup 1`] = `"<section class="ce-section ce-answers" data-block="accordion" data-titled="true" data-variant="notes"><div class="ce-container ce-answers__inner"><div class="ce-head"><h2 class="ce-head__title" data-field="title">Care</h2></div><ul class="ce-answers__items"><li class="ce-answers__item"><details class="ce-answers__details"><summary class="ce-answers__summary"><h3 class="ce-answers__question">Washing</h3><span class="ce-answers__mark" aria-hidden="true"></span></summary><div class="ce-answers__answer"><p>Wash at 30 °C inside out.</p></div></details></li></ul></div></section>"`;
