// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`pricingTable > renders to stable markup 1`] = `"<section class="ce-section ce-plans" data-block="pricingTable" data-count="2"><div class="ce-container ce-plans__inner"><div class="ce-head"><h2 class="ce-head__title" data-field="title">Repair plans</h2></div><ul class="ce-plans__tiers"><li class="ce-plans__tier" data-highlighted="false"><h3 class="ce-plans__name">Single repair</h3><p class="ce-plans__price"><span class="ce-plans__amount">€15</span><span class="ce-plans__interval">per piece</span></p><ul class="ce-plans__features"><li class="ce-plans__feature">Seams and buttons</li><li class="ce-plans__feature">Two weeks</li></ul><div class="ce-plans__action"><a class="cg-action" data-emphasis="secondary" href="/en/repairs">Send a piece</a></div></li><li class="ce-plans__tier" data-highlighted="true"><h3 class="ce-plans__name">Yearly</h3><p class="ce-plans__price"><span class="ce-plans__amount">€60</span><span class="ce-plans__interval">per year</span></p><ul class="ce-plans__features"><li class="ce-plans__feature">Unlimited repairs</li><li class="ce-plans__feature">Collection from home</li></ul><div class="ce-plans__action"><a class="cg-action" data-emphasis="primary" href="/en/repairs/yearly">Join</a></div></li></ul></div></section>"`;
