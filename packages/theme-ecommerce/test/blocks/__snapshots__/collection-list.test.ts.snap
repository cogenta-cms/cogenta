exports[`collectionList, goods > renders to stable markup 1`] = `"<section class="ce-section ce-list" data-block="collectionList" data-layout="grid" data-shape="goods"><div class="ce-container ce-list__inner"><div class="ce-head"><h2 class="ce-head__title" data-field="title">New this season</h2></div><ul class="ce-list__items ce-goods" data-count="3"><li class="ce-goods__item" data-stock="in"><a class="ce-goods__media" href="/en/product/p-jacket" tabindex="-1" aria-hidden="true"><img class="ce-goods__image" src="/img/jacket-1024.avif" srcset="/img/jacket-1024.avif 1024w" sizes="(min-width: 64rem) 22vw, (min-width: 40rem) 30vw, 50vw" width="1024" height="1024" alt="Olive field jacket" loading="lazy" decoding="async"></a><div class="ce-goods__text"><h3 class="ce-goods__name"><a class="ce-goods__link" href="/en/product/p-jacket">Field jacket</a></h3><p class="ce-goods__price"><data value="245">€245</data></p></div></li><li class="ce-goods__item" data-stock="out"><a class="ce-goods__media" href="/en/product/p-mug" tabindex="-1" aria-hidden="true"><img class="ce-goods__image" src="/img/mug-1024.avif" srcset="/img/mug-1024.avif 1024w" sizes="(min-width: 64rem) 22vw, (min-width: 40rem) 30vw, 50vw" width="1024" height="1024" alt="Green enamel mug" loading="lazy" decoding="async"></a><div class="ce-goods__text"><h3 class="ce-goods__name"><a class="ce-goods__link" href="/en/product/p-mug">Enamel mug</a></h3><p class="ce-goods__price"><data value="24.5">€24.50</data></p><p class="ce-goods__stock">Sold out</p></div></li><li class="ce-goods__item"><div class="ce-goods__text"><h3 class="ce-goods__name"><a class="ce-goods__link" href="/en/product/p-card">Leather card holder</a></h3><p class="ce-goods__price"><data value="55">€55</data></p></div></li></ul></div></section>"`;

exports[`collectionList, tiles and index > renders tiles to stable markup 1`] = `"<section class="ce-section ce-list" data-block="collectionList" data-layout="grid" data-shape="tiles"><div class="ce-container ce-list__inner"><div class="ce-head"><h2 class="ce-head__title" data-field="title">New this season</h2></div><ul class="ce-list__items ce-tiles" data-count="2"><li class="ce-tiles__item"><a class="ce-tiles__media" href="/en/category/c-wear" tabindex="-1" aria-hidden="true"><img class="ce-tiles__image" src="/img/wear-1024.avif" srcset="/img/wear-1024.avif 1024w" sizes="(min-width: 64rem) 22vw, 50vw" width="1024" height="1024" alt="Charcoal beanie" loading="lazy" decoding="async"></a><h3 class="ce-tiles__name"><a class="ce-arrow-link" href="/en/category/c-wear">Wear</a></h3><p class="ce-tiles__text">Jackets, shirts and knitwear.</p></li><li class="ce-tiles__item"><a class="ce-tiles__media" href="/en/category/c-kitchen" tabindex="-1" aria-hidden="true"><img class="ce-tiles__image" src="/img/mug-1024.avif" srcset="/img/mug-1024.avif 1024w" sizes="(min-width: 64rem) 22vw, 50vw" width="1024" height="1024" alt="Green enamel mug" loading="lazy" decoding="async"></a><h3 class="ce-tiles__name"><a class="ce-arrow-link" href="/en/category/c-kitchen">Kitchen</a></h3></li></ul></div></section>"`;
