exports[`logos > renders to stable markup 1`] = `"<section class="cs-section cs-logos" data-block="logos" data-count="2"><div class="cs-container cs-logos__inner"><div class="cs-head"><h2 class="cs-head__title" data-field="title">Customers</h2></div><ul class="cs-logos__items"><li class="cs-logos__item"><a class="cs-logos__link" href="https://halvorsen.example" aria-label="Halvorsen Freight" rel="noopener"><img class="cs-logos__image cs-mark" src="/img/halvorsen.png" srcset="/img/halvorsen.png 480w" sizes="12rem" width="480" height="120" alt="Halvorsen Freight" loading="lazy" decoding="async"></a></li><li class="cs-logos__item"><img class="cs-logos__image cs-mark" src="/img/brightwell.png" srcset="/img/brightwell.png 480w" sizes="12rem" width="480" height="120" alt="Brightwell Clinics" loading="lazy" decoding="async"></li></ul></div></section>"`;
